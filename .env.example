# Connection string do Supabase (botão "Connect" > "Direct Connection").
# Se a senha tiver caracteres especiais, faça percent-encoding: @->%40 #->%23 %->%25 /->%2F :->%3A ?->%3F espaço->%20
DATABASE_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres

# Qualquer string aleatória longa, usada para assinar o cookie de sessão.
JWT_SECRET=troque-por-um-valor-aleatorio-longo

# Credenciais de login do único usuário do app.
OWNER_EMAIL=cezar@aurix.com
OWNER_PASSWORD=escolha-uma-senha-forte
OWNER_NAME=Cezar

# Porta local (Render define a dele automaticamente via variável PORT).
PORT=3000
